rules_version = '2';

// Carthigan waitlist — public signup form, locked down everywhere else.
//
// The site only ever WRITES to `waitlist` (one doc per signup). Reads,
// updates and deletes are denied for clients; view signups in the
// Firebase console instead.
service cloud.firestore {
  match /databases/{database}/documents {

    match /waitlist/{docId} {
      allow create: if
        // exact shape — no extra fields
        request.resource.data.keys().hasOnly(
          ['email', 'product', 'timestamp', 'deviceInfo']
        )
        // valid-looking email, bounded length
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 254
        // product tag, bounded length
        && request.resource.data.product is string
        && request.resource.data.product.size() <= 100
        // user-agent string, bounded length
        && request.resource.data.deviceInfo is string
        && request.resource.data.deviceInfo.size() <= 500
        // must use server timestamp (blocks backdated/forged times)
        && request.resource.data.timestamp == request.time;

      allow read, update, delete: if false;
    }

    // everything else: deny all client access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
